
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Study subjects, explore topics and discover lessons on LearnSphere.">
    <title>Subject Learning | LearnSphere</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header class="site-header">
        <div class="container header-content">
            <a href="index.html" class="logo">
                Learn<span>Sphere</span>
            </a>

            <nav class="main-nav">
                <a href="explore.html">Explore</a>
                <a href="library.html">Library</a>
                <a href="resources.html">Resources</a>
            </nav>

            <a href="dashboard.html" class="header-button">
                Dashboard
            </a>
        </div>
    </header>

    <main class="explore-page">
        <div class="container">

            <p class="eyebrow">LEARNSPHERE LEARNING SPACE</p>

            <a href="explore.html" class="resource-link">
                ← Back to Explore
            </a>

            <section class="subject-overview">
                <h1 id="subjectTitle">Loading subject...</h1>

                <p id="subjectDescription">
                    Preparing your learning space...
                </p>

                <p id="subjectStatus" class="status-line"
                   aria-live="polite">
                    Loading subject information...
                </p>
            </section>

            <section class="topics-section">
                <h2>Topics to Study</h2>

                <p>
                    Explore the topics available in this subject.
                </p>

                <div id="topicGrid" class="resource-grid"></div>
            </section>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="config.js"></script>
    <script src="subject.js"></script>

</body>
</html>
